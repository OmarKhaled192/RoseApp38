{
  "name": "roseApp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/roseApp/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "outputPath": "dist/apps/roseApp",
        "browser": "apps/roseApp/src/main.ts",
        "index": "apps/roseApp/src/index.html",
        "tsConfig": "apps/roseApp/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/roseApp/public"
          }
        ],
        "styles": [
          "apps/roseApp/src/styles.css"
        ]
      },
      "configurations": {
        "development": {},
        "production": {}
      },
      "defaultConfiguration": "development"
    },

    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "options": {
        "port": 4203,
        "publicHost": "http://localhost:4203"
      },
      "configurations": {
        "production": {
          "buildTarget": "roseApp:build:production"
        },
        "development": {
          "buildTarget": "roseApp:build:development"
        }
      },
      "defaultConfiguration": "development"
    },

    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "roseApp:build"
      }
    },

    "lint": {
      "executor": "@nx/eslint:lint"
    },

    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "roseApp:build",
        "port": 4203,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "roseApp:build:development"
        },
        "production": {
          "buildTarget": "roseApp:build:production"
        }
      }
    }
  }
}
